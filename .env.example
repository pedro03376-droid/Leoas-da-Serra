# Sanity (CMS). Sem isso, o site usa os dados placeholder em src/lib/placeholders.ts.
SANITY_PROJECT_ID=pvg8mwks
SANITY_DATASET=production
# So necessario se o dataset nao for publico.
SANITY_READ_TOKEN=

# Nuvemshop (loja). Dominio real da loja, usado por onCheckout() no checkout.
NEXT_PUBLIC_NUVEMSHOP_STORE_URL=https://leoasdaserra.lojavirtualnuvem.com.br

# Melhor Envio (estimativa de frete na pagina do produto). Sem isso, o
# widget "calcular frete" fica indisponivel — o resto do site funciona
# normalmente. Token gerado em melhorenvio.com.br > Gerenciar > Tokens de
# integracao (NUNCA usar prefixo NEXT_PUBLIC_ aqui, o token e secreto e so
# deve rodar no servidor). CEP de origem e o do local de onde as camisas
# sao enviadas (sem hifen).
MELHOR_ENVIO_TOKEN=
MELHOR_ENVIO_CEP_ORIGEM=
# "true" usa o ambiente de testes (sandbox.melhorenvio.com.br) em vez do de producao.
MELHOR_ENVIO_SANDBOX=

# Checkout proprio (Supabase + Mercado Pago). Sem essas variaveis o site
# continua vendendo pela Nuvemshop normalmente -- so vira "custom" quando
# NEXT_PUBLIC_CHECKOUT_MODE=custom estiver setado E as credenciais abaixo
# estiverem preenchidas. Ate la, e seguro fazer deploy com tudo isso vazio.

# Supabase: Project Settings > API. Usar a "service_role" key (NAO a
# "anon"/publica) -- ela so pode ser usada no servidor, nunca com prefixo
# NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Mercado Pago: developers.mercadopago.com.br > Suas integracoes > credenciais
# de producao. O access token e secreto (nunca NEXT_PUBLIC_). O webhook
# secret aparece ao configurar a notificacao em Webhooks > Configurar notificacoes.
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=

# "custom" troca o botao "Finalizar compra" da Nuvemshop pro checkout
# proprio (/loja/checkout). Deixar em branco/"nuvemshop" ate testar tudo.
NEXT_PUBLIC_CHECKOUT_MODE=

# Usado pra montar as URLs de retorno/notificacao do Mercado Pago
# (back_urls, notification_url). Sem isso, cai no dominio da requisicao.
NEXT_PUBLIC_SITE_URL=https://leoas-da-serra.vercel.app
